<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AgentDesk.Views.AddGroupPage"
    xmlns:ext="clr-namespace:AgentDesk.CustomeControls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    NavigationPage.HasNavigationBar="False"
    x:Name="page" 
    BindingContext="{Binding ViewModel, Source={x:Reference page}}">
    <Grid>
        <Image Aspect="AspectFit" Source="img_bg" />
        <Grid
            Padding="20,0,20,10"
            RowDefinitions="Auto,*"
            RowSpacing="10">
            <Grid
                Grid.Row="0"
                ColumnDefinitions="Auto,*">
                <Image
                    Grid.Column="0"
                    Source="icon_back"
                    Style="{StaticResource ImgSmall}"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer
                                    Command="{Binding BackCommand}" />
                    </Image.GestureRecognizers>

                </Image>

                <Label
                    Grid.Column="1"
                    Text="{Binding Title}"
                    FontSize="22"
                    Style="{StaticResource lblMedium}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center"
                    TextColor="#000000" />

            </Grid>
            <VerticalStackLayout
                Grid.Row="1"
                Spacing="15"
                Margin="0,0,0,0">

                <!--<VerticalStackLayout Spacing="4">
                    <StackLayout Spacing="8">
                        <Label
                            FontSize="14">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span 
                                        Style="{StaticResource lblMedium}" 
                                        Text="Code" />
                                    <Span
                                        Text=" *"
                                        Style="{StaticResource lblMedium}" 
                                        TextColor="{StaticResource AppRed}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border
                            
                            Stroke="{Binding HasCodeError, Converter={StaticResource BoolToErrorColorConverter}}" 
                            Style="{StaticResource ExtBorder}">
                            <ext:BorderlessEntry
                                Text="{Binding Code}"
                                ReturnType="Next"
                                Placeholder="Enter Code"
                                MaxLength="25"
                                Style="{StaticResource extEntry}" />
                        </Border>
                    </StackLayout>
                    <Label
                        FontSize="14"
                        Text="{Binding CodeError}"
                        TextColor="{StaticResource AppRed}"
                        HorizontalOptions="Start"
                        IsVisible="{Binding HasCodeError}" />
                </VerticalStackLayout>-->

                <VerticalStackLayout Spacing="4">
                    <StackLayout Spacing="8">

                        <Label
                            FontSize="14">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span 
                                        Text="Name" 
                                        Style="{StaticResource lblMedium}"/>
                                    <Span
                                        Text=" *"
                                        Style="{StaticResource lblMedium}" 
                                        TextColor="{StaticResource AppRed}" />

                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <Border
                            
                            Stroke="{Binding HasNameError, Converter={StaticResource BoolToErrorColorConverter}}" 
                            Style="{StaticResource ExtBorder}">

                            <ext:BorderlessEntry
                                Text="{Binding Name}"
                                Placeholder="Enter Name"
                                ReturnType="Next"
                                MaxLength="50"
                                Keyboard="Text"
                                TextChanged="NameEntry_TextChanged"
                                Style="{StaticResource extEntry}" />
                        </Border>

                    </StackLayout>
                    <Label
                        FontSize="14"
                        Text="{Binding NameError}"
                        TextColor="{StaticResource AppRed}"
                        HorizontalOptions="Start"
                        IsVisible="{Binding HasNameError}" />
                </VerticalStackLayout>


                <VerticalStackLayout Spacing="4">
                    <StackLayout Spacing="8">

                        <Label
                            FontSize="14">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span 
                                        Text="Head Name" 
                                        Style="{StaticResource lblMedium}"/>

                                    <Span
                                        Text=" *"
                                        Style="{StaticResource lblMedium}" 
                                        TextColor="{StaticResource AppRed}" />

                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <Border
                            
                            Stroke="{Binding HasHeadNameError, Converter={StaticResource BoolToErrorColorConverter}}"
                            Style="{StaticResource ExtBorder}">

                            <ext:BorderlessEntry
                                Text="{Binding HeadName}"
                                ReturnType="Next"
                                MaxLength="50"
                                Keyboard="Text"
                                Placeholder="Enter Head Name"
                                TextChanged="HeadNameEntry_TextChanged"
                                Style="{StaticResource extEntry}" />
                        </Border>

                    </StackLayout>
                    <Label
                        FontSize="14"
                        Text="{Binding HeadNameError}"
                        TextColor="{StaticResource AppRed}"
                        HorizontalOptions="Start"
                        IsVisible="{Binding HasHeadNameError}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <StackLayout Spacing="8">
                        <Label FontSize="14">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span 
                                        Text="Mobile Number"
                                        Style="{StaticResource lblMedium}"/>
                                    <Span
                                        Text=" *"
                                        Style="{StaticResource lblMedium}" 
                                        TextColor="{StaticResource AppRed}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Border
                            
                            Stroke="{Binding HasMobileNumberError, Converter={StaticResource BoolToErrorColorConverter}}"
                            Style="{StaticResource ExtBorder}">

                            <HorizontalStackLayout Spacing="5">

                                <!-- Country Code -->
                                <Label
                                    Text="+91"
                                    Style="{StaticResource lblRegular}"
                                    VerticalOptions="Center"
                                    FontSize="15" />

                                <!-- Mobile Number -->
                                <ext:BorderlessEntry
                                    Text="{Binding MobileNumber, Mode=TwoWay}"
                                    ReturnType="Done"
                                    Keyboard="Numeric"
                                    Placeholder="Enter Mobile Number"
                                    MaxLength="11"
                                    Style="{StaticResource extEntry}" >
                                    <ext:BorderlessEntry.Behaviors>
                                        <toolkit:MaskedBehavior Mask="XXXXX XXXXX" />
                                    </ext:BorderlessEntry.Behaviors>
                                </ext:BorderlessEntry>

                            </HorizontalStackLayout>

                        </Border>
                    </StackLayout>
                    <Label
                        FontSize="14"
                        Text="{Binding MobileNumberError}"
                        TextColor="{StaticResource AppRed}"
                        HorizontalOptions="Start"
                        IsVisible="{Binding HasMobileNumberError}" />
                </VerticalStackLayout>

                <StackLayout
                    HorizontalOptions="Start"
                    Orientation="Horizontal"
                    Spacing="5">
                    <syncfusion:SfSwitch
                        IsOn="{Binding IsActive, Mode=TwoWay}"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">

                                <VisualState x:Name="On">
                                    <VisualState.Setters>
                                        <Setter Property="SwitchSettings">
                                            <Setter.Value>
                                                <syncfusion:SwitchSettings
                                                    TrackHeightRequest="25"
                                                    ThumbBackground="#FF00AEEF"
                                                    ThumbStroke="#FF00AEEF"
                                                    TrackBackground="#2200AEEF"
                                                    TrackStroke="#FF00AEEF" />
                                                <!--<syncfusion:SwitchSettings
                                                    TrackHeightRequest="25"
                                                    ThumbBackground="#FF029BFF"
                                                    ThumbStroke="#FF029BFF"
                                                    TrackBackground="#22029BFF"
                                                    TrackStroke="#FF029BFF" />-->
                                            </Setter.Value>
                                        </Setter>
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Off">
                                    <VisualState.Setters>
                                        <Setter Property="SwitchSettings">
                                            <Setter.Value>
                                                <syncfusion:SwitchSettings
                                                    TrackHeightRequest="25"
                                                    ThumbBackground="#808080"
                                                    ThumbStroke="#808080"
                                                    TrackBackground="#E8E1EB"
                                                    TrackStroke="#827B88" />
                                            </Setter.Value>
                                        </Setter>
                                    </VisualState.Setters>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                    </syncfusion:SfSwitch>

                    <Label
                         FontSize="15.5"
                         HorizontalOptions="Start"
                         Text="Is Active?"
                         VerticalTextAlignment="Center"
                         Style="{StaticResource lblRegular}"
                         TextColor="{StaticResource AppBlack}"
                         VerticalOptions="Center" />
                </StackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button
                        Command="{Binding SubmitCommand}"
                        Style="{StaticResource BtnPrimary}"
                        Text="Submit" />
                    <Button
                        Background="White"
                        Grid.Column="1"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource BtnSecondary}"
                        Text="Close" />
                </Grid>
            </VerticalStackLayout>

        </Grid>
    </Grid>
</ContentPage>