<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AgentDesk.Views.HomePage"
    xmlns:controls="clr-namespace:AgentDesk.CustomeControls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="page"
    BindingContext="{Binding ViewModel, Source={x:Reference page}}">

    <Grid>
        <Image Aspect="AspectFit" Source="img_bg" />
        <Grid
            RowDefinitions="Auto,*"
            Padding="12"
            RowSpacing="12">

            <!-- Header -->
            <!--<Label
                Grid.Row="0"
                Text="AgentDesk"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#222222"
                VerticalOptions="Center"
                Margin="4,8" />-->

            <Image
                Grid.Row="0"
                Aspect="AspectFit"
                WidthRequest="200"
                Source="app_logo.png"/>

            <!-- Menu Grid -->
            <CollectionView 
                Grid.Row="1"
                ItemsSource="{Binding MenuItems}"
                SelectionMode="None">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="3"
                        HorizontalItemSpacing="20"
                        VerticalItemSpacing="20" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <!--<DataTemplate>

                        <Border
                            BackgroundColor="#EAF8FC"
                            Stroke="{StaticResource AppPrimary}"
                            StrokeThickness="1"
                            HeightRequest="125"
                            Padding="6">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow
                                    Brush="#000000"
                                    Offset="0,2"
                                    Radius="4"
                                    Opacity="0.12" />
                            </Border.Shadow>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference page}, Path=ViewModel.OpenMenuCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="75,*"
                                  RowSpacing="4">

                                --><!-- Menu Icon --><!--
                                <Image
                                    Grid.Row="0"
                                    Source="{Binding Icon}"
                                    HeightRequest="30"
                                    WidthRequest="30"
                                    Aspect="AspectFit"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" >
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="{StaticResource AppPrimary}" />
                                    </Image.Behaviors>
                                </Image>

                                --><!-- Menu Title --><!--
                                <Label
                                    Grid.Row="1"
                                    Text="{Binding Title}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#333333"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    LineBreakMode="WordWrap" />

                            </Grid>
                        </Border>

                    </DataTemplate>-->

                    <DataTemplate>
                        <Grid>

                            <!-- Light background -->
                            <Border
                                Margin="5"
            BackgroundColor="#EAF8FC"
            StrokeThickness="0"
            Padding="6">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                            </Border>

                            <!-- Custom corner outline -->
                            <GraphicsView
            Drawable="{StaticResource MenuCardDrawable}"
            InputTransparent="True" />

                            <!-- Card tap and content -->
                            <Grid Padding="20"
              RowDefinitions="Auto,Auto"
              RowSpacing="10">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                    Command="{Binding Source={x:Reference page},
                        Path=ViewModel.OpenMenuCommand}"
                    CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <Image
                Grid.Row="0"
                Source="{Binding Icon}"
                HeightRequest="30"
                WidthRequest="30"
                Aspect="AspectFit"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior
                        TintColor="{StaticResource AppPrimary}" />
                                    </Image.Behaviors>
                                </Image>

                                <Label
                Grid.Row="1"
                Text="{Binding Title}"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="#333333"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                LineBreakMode="WordWrap" />

                            </Grid>
                        </Grid>
                    </DataTemplate>
                    
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>
    </Grid>

</ContentPage>