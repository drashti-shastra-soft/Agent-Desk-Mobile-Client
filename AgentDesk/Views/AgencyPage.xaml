                <CollectionView
                    Grid.Row="1"
                    ItemsSource="{Binding AgencyList}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Never">

                    <!--Empty State-->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout
                            Spacing="12"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border
                                Background="#E0F5FF"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 36"
                                StrokeThickness="0"
                                HeightRequest="72"
                                WidthRequest="72">
                                <Image
                                    Source="home_blue_icon.png"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HeightRequest="36"
                                    WidthRequest="36" />
                            </Border>
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Style="{StaticResource lblMedium}"
                                Text="No Agency Found"
                                TextColor="#1A1A1A" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="15,0" Margin="0,10,0,0">
                                <Border
                                    Padding="0"
                                    Background="White"
                                    Stroke="#BFE3F5"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1">
                                    <Border.Shadow>
                                        <Shadow
                                            Brush="Black"
                                            Opacity="0.05"
                                            Radius="8"
                                            Offset="0,2" />
                                    </Border.Shadow>

                                    <Grid RowDefinitions="Auto,Auto,1,Auto">

                                        <!-- Blue header: name, code, status -->
                                        <VerticalStackLayout
                                            Grid.Row="0"
                                            BackgroundColor="#1E9BD7"
                                            Padding="12,8"
                                            Spacing="3">

                                            <Label
                                                Text="{Binding Name}"
                                                Style="{StaticResource lblMedium}"
                                                FontSize="16"
                                                TextColor="White"
                                                LineBreakMode="TailTruncation" />

                                            <HorizontalStackLayout Spacing="8">
                                                <Label
                                                    Text="{Binding Code, StringFormat='Code: {0}'}"
                                                    FontSize="12"
                                                    Style="{StaticResource lblRegular}"
                                                    TextColor="White"
                                                    VerticalTextAlignment="Center" />
                                                <Border
                                                    Padding="5,0"
                                                    BackgroundColor="{Binding IsActive, Converter={StaticResource StatusBackgroundConverter}}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 4">
                                                    <Label
                                                        Text="{Binding IsActive, Converter={StaticResource StatusTextConverter}}"
                                                        FontSize="12"
                                                        Style="{StaticResource lblMedium}"
                                                        TextColor="{Binding IsActive, Converter={StaticResource StatusForegroundConverter}}"
                                                        VerticalTextAlignment="Center" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Body: same pattern as old design -->
                                        <Grid
                                            Grid.Row="1"
                                            Padding="12,10"
                                            RowDefinitions="*,*"
                                            RowSpacing="10"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="10">

                                            <!--Agency Type-->
                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Spacing="2">
                                                <Label
                                                    Text="Agency Type"
                                                    Style="{StaticResource lblMedium}" />
                                                <Label
                                                    Text="{Binding AgencyType}"
                                                    Style="{StaticResource lblRegular}"
                                                    TextColor="{StaticResource AppLightGray}"
                                                    LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <!--Company Name-->
                                            <VerticalStackLayout
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Spacing="2"
                                                HorizontalOptions="End">
                                                <Label
                                                    Text="Company Name"
                                                    Style="{StaticResource lblMedium}"
                                                    HorizontalTextAlignment="End" />
                                                <Label
                                                    Text="{Binding CompanyName}"
                                                    Style="{StaticResource lblRegular}"
                                                    TextColor="{StaticResource AppLightGray}"
                                                    HorizontalTextAlignment="End" />
                                            </VerticalStackLayout>

                                            <!--Mobile Number-->
                                            <VerticalStackLayout
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Spacing="2">
                                                <Label
                                                    Text="Mobile Number"
                                                    Style="{StaticResource lblMedium}" />
                                                <Label
                                                    Text="{Binding MobileNumber}"
                                                    Style="{StaticResource lblRegular}"
                                                    TextColor="{StaticResource AppLightGray}" />
                                            </VerticalStackLayout>

                                            <!--Email Address-->
                                            <VerticalStackLayout
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Spacing="2"
                                                HorizontalOptions="End">
                                                <Label
                                                    Text="Email Address"
                                                    Style="{StaticResource lblMedium}"
                                                    HorizontalTextAlignment="End" />
                                                <Label
                                                    Text="{Binding EmailAddress}"
                                                    Style="{StaticResource lblRegular}"
                                                    TextColor="{StaticResource AppLightGray}"
                                                    HorizontalTextAlignment="End"
                                                    LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Divider -->
                                        <BoxView
                                            Grid.Row="2"
                                            HeightRequest="1"
                                            Color="#BFE3F5" />

                                        <!-- Footer actions: Edit ,  Delete -->
                                        <Grid
                                            Grid.Row="3"
                                            ColumnDefinitions="*,1,*"
                                            Padding="0,5">

                                            <!-- Edit -->
                                            <Border
                                                Grid.Column="0"
                                                WidthRequest="30"
                                                HeightRequest="30"
                                                Stroke="Transparent"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                StrokeShape="RoundRectangle 6"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">

                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference page}, Path=ViewModel.EditAgencyCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>

                                                <Image
                                                    Source="edit_icon.png"
                                                    Aspect="AspectFit"
                                                    Margin="6" />
                                            </Border>

                                            <BoxView
                                                Grid.Column="1"
                                                WidthRequest="1"
                                                Margin="0,2"
                                                Color="#1E9BD7" />

                                            <!-- Delete -->
                                            <Border
                                                Grid.Column="2"
                                                WidthRequest="30"
                                                HeightRequest="30"
                                                Stroke="Transparent"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                StrokeShape="RoundRectangle 6"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">

                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference page}, Path=ViewModel.DeleteAgencyCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>

                                                <Image
                                                    Source="delete_icon.png"
                                                    Aspect="AspectFit"
                                                    Margin="7" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Border
                    Grid.Row="1"
                    Margin="0,0,15,15"
                    Background="{StaticResource AppPrimary}"
                    HeightRequest="50"
                    HorizontalOptions="End"
                    Stroke="Transparent"
                    StrokeShape="{RoundRectangle CornerRadius=25}"
                    VerticalOptions="End"
                    WidthRequest="50">
                    <Image
                        Aspect="AspectFit"
                        HeightRequest="20"
                        Source="add_icon"
                        WidthRequest="20" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddAgencyCommand}" />
                    </Border.GestureRecognizers>
                </Border>




            </Grid>
        </RefreshView>
    </Grid>
</ContentPage>