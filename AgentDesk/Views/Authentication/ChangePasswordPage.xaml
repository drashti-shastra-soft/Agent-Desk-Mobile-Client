<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AgentDesk.Views.Authentication.ChangePasswordPage"
    xmlns:ext="clr-namespace:AgentDesk.CustomeControls"
    x:Name="page" 
    BindingContext="{Binding ViewModel, Source={x:Reference page}}">

    <Grid>
        <Image Aspect="AspectFit" Source="img_bg" />
        <Grid
            Margin="15,10"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="15">

            <Image
                Grid.Row="0"
                Aspect="AspectFit"
                HeightRequest="25"
                HorizontalOptions="Start"
                Source="icon_back"
                Style="{StaticResource ImgSmall}"
                VerticalOptions="Start"
                WidthRequest="25">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}"/>
                </Image.GestureRecognizers>
            </Image>

            <Image
                Grid.Row="1"
                Aspect="AspectFit"
                Source="img_resetpassword" />

            <StackLayout Grid.Row="2" Spacing="10">

                <Label
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource lblMedium}"
                    Text="Change Your Password" />

                <Label
                    FontSize="14"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource lblRegular}"
                    Text="You Can Now Change Your Password"
                    TextColor="#A7A7A7" />
            </StackLayout>
            <VerticalStackLayout Grid.Row="3" Spacing="4">
                <StackLayout Grid.Row="3" Spacing="8">
                    <Label
                        FontSize="15"
                        Style="{StaticResource lblMedium}"
                        Text="Current Password"
                        TextColor="#000000" />

                    <Border
                        Padding="0,0,10,0"
                        Stroke="{Binding HasCurrentPasswordError,Converter={StaticResource BoolToErrorColorConverter}}"
                        Style="{StaticResource ExtBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <ext:BorderlessEntry
                                Text="{Binding CurrentPassword}"
                                IsPassword="{Binding IsCurrentPasswordHidden}"
                                Placeholder="********"
                                ReturnType="Next"
                                Style="{StaticResource extAuthEntry}" />
                            <Image
                                x:Name="iconCurrentPassword"
                                Grid.Column="1"
                                Aspect="AspectFit"
                                Source="{Binding IsCurrentPasswordHidden,Converter={StaticResource PasswordIconConverter}}"
                                Style="{StaticResource ImgSmall}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleCurrentPasswordCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>
                </StackLayout>
                <Label
                    FontSize="14"
                    Text="{Binding CurrentPasswordError}"
                    TextColor="{StaticResource AppRed}"
                    HorizontalOptions="Start"
                    IsVisible="{Binding HasCurrentPasswordError}" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="4" Spacing="4">
                <StackLayout Grid.Row="4" Spacing="8">
                    <Label
                    FontSize="15"
                    Style="{StaticResource lblMedium}"
                    Text="New Password"
                    TextColor="#000000" />

                    <Border
                    Padding="0,0,10,0"
                    Stroke="{Binding HasNewPasswordError,Converter={StaticResource BoolToErrorColorConverter}}"
                    Style="{StaticResource ExtBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <ext:BorderlessEntry
                            Text="{Binding NewPassword}"
                            IsPassword="{Binding IsNewPasswordHidden}"
                            Placeholder="********"
                            ReturnType="Next"
                            Style="{StaticResource extAuthEntry}" />
                            <Image
                            x:Name="IconNewPassword"
                            Grid.Column="1"
                            Aspect="AspectFit"
                            Source="{Binding IsNewPasswordHidden,Converter={StaticResource PasswordIconConverter}}"
                            Style="{StaticResource ImgSmall}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleNewPasswordCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>
                </StackLayout>
                <Label
                    FontSize="14"
                    Text="{Binding NewPasswordError}"
                    TextColor="{StaticResource AppRed}"
                    HorizontalOptions="Start"
                    IsVisible="{Binding HasNewPasswordError}" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="5" Spacing="4">
                <StackLayout Grid.Row="5" Spacing="8">
                    <Label
                    FontSize="15"
                    Style="{StaticResource lblMedium}"
                    Text="Confirm Password"
                    TextColor="#000000" />

                    <Border
                    Padding="0,0,10,0"
                    Stroke="{Binding HasConfirmPasswordError,
                        Converter={StaticResource BoolToErrorColorConverter}}"
                    Style="{StaticResource ExtBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <ext:BorderlessEntry
                            Text="{Binding ConfirmPassword}"
                            IsPassword="{Binding IsConfirmPasswordHidden}"
                            Placeholder="********"
                            ReturnType="Done"
                            Style="{StaticResource extAuthEntry}" />
                            <Image
                            x:Name="IconConfirmPassword"
                            Grid.Column="1"
                            Aspect="AspectFit"
                            Source="{Binding IsConfirmPasswordHidden,Converter={StaticResource PasswordIconConverter}}"
                            Style="{StaticResource ImgSmall}">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleConfirmPasswordCommand}" />
                                </Image.GestureRecognizers>
                            </Image>

                        </Grid>
                    </Border>
                </StackLayout>
                <Label
                    FontSize="14"
                    Text="{Binding ConfirmPasswordError}"
                    TextColor="{StaticResource AppRed}"
                    HorizontalOptions="Start"
                    IsVisible="{Binding HasConfirmPasswordError}" />
            </VerticalStackLayout>

            <Button
                Grid.Row="6"
                Margin="0,10,0,0"
                Command="{Binding ChangePasswordCommand}"
                Style="{StaticResource BtnPrimary}"
                Text="Change Password" />
        </Grid>
    </Grid>

</ContentPage>