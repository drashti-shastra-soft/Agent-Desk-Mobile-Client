<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AgentDesk.Views.Authentication.ForgotPasswordPage"
    xmlns:ext="clr-namespace:AgentDesk.CustomeControls"
    x:Name="page"
    BindingContext="{Binding ViewModel, Source={x:Reference page}}">
    <Grid>
        <Image Aspect="AspectFit" Source="img_bg" />
        <Grid
            Margin="15,15"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
            RowSpacing="15">

            <Image
                Grid.Row="0"
                Aspect="AspectFit"
                HorizontalOptions="Start"
                Source="icon_back"
                Style="{StaticResource ImgSmall}"
                VerticalOptions="Start">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Command="{Binding BackCommand}"/>
                </Image.GestureRecognizers>
            </Image>

            <Image
                    Grid.Row="1"
                    Aspect="AspectFit"
                    Source="img_forgot" />

            <StackLayout Grid.Row="2" Spacing="10" Padding="0,0,0,15">

                <Label
                    Style="{StaticResource lblMedium}"
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text="Forgot Password?" />

                <Label
                    FontSize="14"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource lblRegular}"
                    Text="Don't worry! It occurs please enter the email address linked with your account."
                    TextColor="#A7A7A7" />
            </StackLayout>

            <VerticalStackLayout Grid.Row="3" Spacing="4">
                <StackLayout  Spacing="10">
                    <Label
                        FontSize="15"
                        Style="{StaticResource lblMedium}"
                        Text="Email Address" />
                    <Border
                        Padding="0,0,10,0"
                        Style="{StaticResource ExtBorder}"
                        Stroke="{Binding HasEmailAddressError, Converter={StaticResource BoolToErrorColorConverter}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <ext:BorderlessEntry
                                Text="{Binding EmailAddress}"
                                Keyboard="Email"
                                Placeholder="abc@gmail.com"
                                Style="{StaticResource extAuthEntry}" />
                            <Image
                                Grid.Column="1"
                                Aspect="AspectFit"
                                Source="icon_mail"
                                Style="{StaticResource ImgSmall}" />
                        </Grid>
                    </Border>
                </StackLayout>
                <Label
                    FontSize="14"
                    Text="{Binding EmailAddressError}"
                    TextColor="{StaticResource AppRed}"
                    HorizontalOptions="Start"
                    IsVisible="{Binding HasEmailAddressError}" />
            </VerticalStackLayout>

            <Button
                Grid.Row="4"
                Margin="0,30,0,0"  
                Command="{Binding SubmitCommand}"
                Style="{StaticResource BtnPrimary}"
                Text="Submit" />

            <Label
                Grid.Row="5"
                x:Name="LblForgotPassword"
                FontSize="15"
                Style="{StaticResource lblMedium}"
                Text="Back To Login"
                TextColor="{StaticResource AppPrimary}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackToLoginCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>
    </Grid>
</ContentPage>