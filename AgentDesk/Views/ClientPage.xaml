                        </Image.GestureRecognizers>
                    </Image>

                    <Label
                        Grid.Column="1"
                        Text="Client"
                        FontSize="22"
                        Style="{StaticResource lblMedium}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center" />
                </Grid>

                <CollectionView
                    Grid.Row="1"
                    ItemsSource="{Binding ClientList}"
                    SelectionMode="None"
                    VerticalScrollBarVisibility="Never">

