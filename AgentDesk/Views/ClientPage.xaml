                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HeightRequest="36"
                                    WidthRequest="36">
                                </Image>
                            </Border>
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Style="{StaticResource lblMedium}"
                                Text="No Client Found"
                                TextColor="#1A1A1A" />

                        </VerticalStackLayout>
