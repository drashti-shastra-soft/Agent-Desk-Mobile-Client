<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ext="clr-namespace:AgentDesk.CustomeControls"
    x:Class="AgentDesk.Views.Tabs.HealthTabView">

    <!-- BindingContext = HealthTabViewModel -->
    <VerticalStackLayout Spacing="15">
        <ext:LabeledEntry Title="Medical History" IsRequired="True"
                          Placeholder="Enter Medical History" MaxLength="500"
                          Text="{Binding MedicalHistory}"
                          ErrorText="{Binding MedicalHistoryError}"
                          HasError="{Binding HasMedicalHistoryError}" />

        <ext:LabeledEntry Title="Current Medications" IsRequired="True"
                          Placeholder="Enter Current Medications" MaxLength="500"
                          Text="{Binding CurrentMedications}"
                          ErrorText="{Binding CurrentMedicationsError}"
                          HasError="{Binding HasCurrentMedicationsError}" />

        <ext:LabeledEntry Title="Smoking Alcohol Habits" IsRequired="True"
                          Placeholder="Enter Smoking Alcohol Habits" MaxLength="500"
                          Text="{Binding SmokingAlcoholHabits}"
                          ErrorText="{Binding SmokingAlcoholHabitsError}"
                          HasError="{Binding HasSmokingAlcoholHabitsError}" />

        <ext:LabeledEntry Title="Family Medical History" IsRequired="True"
                          Placeholder="Enter Family History" MaxLength="500"
                          Text="{Binding FamilyMedicalHistory}"
                          ErrorText="{Binding FamilyMedicalHistoryError}"
                          HasError="{Binding HasFamilyMedicalHistoryError}" />

        <Button Text="Save"
                Margin="0,20,0,10"
                Command="{Binding SaveCommand}"
                Style="{StaticResource BtnPrimary}" />
    </VerticalStackLayout>
</ContentView>
