<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AgentDesk.Views.Tabs.DocumentsTabView"
    x:Name="root">

    <!-- BindingContext = DocumentsTabViewModel -->
    <VerticalStackLayout Spacing="15">

        <!-- Upload box -->
        <Border Style="{StaticResource ExtBorder}" Padding="20" HeightRequest="150">
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                <Border WidthRequest="48" HeightRequest="48"
                        BackgroundColor="#00A0E3"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24">
                    <Label Text="+" TextColor="White" FontSize="28"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Click Here to Upload Your File"
                       FontSize="15"
                       Style="{StaticResource lblMedium}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Supported Format: JPEG, PNG (10 mb Each)"
                       FontSize="12"
                       TextColor="#9B9B9B"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding PickFilesCommand}" />
            </Border.GestureRecognizers>
        </Border>

        <!-- File list -->
        <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Documents}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ExtBorder}" Padding="10">
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="Auto,*,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="6">

                            <Image Source="{Binding FilePath}"
                                   WidthRequest="48" HeightRequest="48"
                                   Aspect="AspectFill" />

                            <Label Grid.Column="1"
                                   Text="{Binding FileName}"
                                   LineBreakMode="MiddleTruncation"
                                   VerticalOptions="Center" />

                            <!-- Replace with your own green tick icon -->
                            <Image Grid.Column="2"
                                   Source="icon_check_green"
                                   WidthRequest="22" HeightRequest="22"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsUploaded}" />

                            <!-- Replace with your own red delete icon -->
                            <Image Grid.Column="3"
                                   Source="icon_delete_red"
                                   WidthRequest="22" HeightRequest="22"
                                   VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference root}, Path=BindingContext.DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                                </Image.GestureRecognizers>
                            </Image>

                            <!-- Progress (only while uploading) -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="4"
                                  ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding IsUploading}">
                                <ProgressBar Progress="{Binding Progress}"
                                             ProgressColor="#00A0E3"
                                             VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding ProgressText}"
                                       Margin="8,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <Button Text="Save"
                Margin="0,20,0,10"
                Command="{Binding SaveCommand}"
                Style="{StaticResource BtnPrimary}" />
    </VerticalStackLayout>
</ContentView>
